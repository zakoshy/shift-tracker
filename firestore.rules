
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getProfile().role == 'super-admin';
    }

    function isAdmin() {
      return isSignedIn() && (getProfile().role == 'admin' || getProfile().role == 'super-admin');
    }

    // --- Organizations ---
    
    match /organizations/{orgId} {
      allow create: if isSignedIn();
      allow read: if true; // Publicly readable for checkpoint verification
      allow update, delete: if isSuperAdmin() || (isAdmin() && getProfile().organizationId == orgId);
    }

    // --- User Profiles ---
    
    match /users/{userId} {
      allow create: if isSignedIn();
      
      // Get: Individual access or Admin/Super-Admin oversight
      allow get: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        (getProfile().role == 'admin' && resource.data.organizationId == getProfile().organizationId)
      );
      
      // List: Queries MUST filter by organizationId if not a Super Admin
      allow list: if isSignedIn() && (
        isSuperAdmin() || 
        (request.query.filters.userId == request.auth.uid) ||
        (getProfile().role == 'admin' && request.query.filters.organizationId == getProfile().organizationId)
      );

      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // --- Attendance Logs ---
    
    match /attendance_logs/{logId} {
      // Get: Individual access, Org Admin, or Super Admin
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.organizationId == getProfile().organizationId
      );

      // List: Queries MUST filter by organizationId or userId to match permissions
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (request.query.filters.userId == request.auth.uid) ||
        (getProfile().role == 'admin' && request.query.filters.organizationId == getProfile().organizationId)
      );
      
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
                    
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid || 
        (getProfile().role == 'admin' && resource.data.organizationId == getProfile().organizationId)
      );
      
      allow delete: if isAdmin();
    }

    // --- Visitor Logs ---
    
    match /visitor_logs/{logId} {
      // Security: Public creation is allowed, but we validate the data structure
      allow create: if request.resource.data.name != null 
                    && request.resource.data.phone != null
                    && request.resource.data.organizationId != null;
                    
      allow read, list: if isSuperAdmin() || (isAdmin() && resource.data.organizationId == getProfile().organizationId);
      allow delete: if isSuperAdmin();
    }
  }
}
