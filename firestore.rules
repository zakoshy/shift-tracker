
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get the requesting user's profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if the requesting user is a super admin
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super-admin';
    }

    // Helper: Check if the requesting user is an admin of their organization
    function isOrgAdmin(orgId) {
      return isSignedIn() && 
             getUserData().role == 'admin' && 
             getUserData().organizationId == orgId;
    }

    // Helper: Check if an organization is suspended
    function isNotSuspended(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.suspended != true;
    }

    // Organizations: Super admins can do everything. Authenticated users can read.
    match /organizations/{orgId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isOrgAdmin(orgId);
    }

    // User Profiles: Super admins full access. Users can read/write their own. Admins can read their org's staff.
    match /users/{userId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == userId || 
        isOrgAdmin(resource.data.organizationId)
      );
      allow update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
      allow delete: if isSuperAdmin() || (isSignedIn() && isOrgAdmin(getUserData().organizationId));
    }

    // Attendance Logs: 
    // 1. Staff can create/read/update their own if not suspended.
    // 2. Admins can read/list logs for their specific organization.
    // 3. Super admins have global access.
    match /attendance_logs/{logId} {
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid && 
                    isNotSuspended(request.resource.data.organizationId);
      
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid || 
        (getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId)
      );
      
      allow update: if isSignedIn() && 
                    resource.data.userId == request.auth.uid && 
                    isNotSuspended(resource.data.organizationId);
      
      allow delete: if isSuperAdmin() || (isSignedIn() && isOrgAdmin(resource.data.organizationId));
    }
  }
}
