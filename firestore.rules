
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get the requesting user's profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if the requesting user is a super admin
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super-admin';
    }

    // Helper: Check if the requesting user is an admin of a specific organization
    function isOrgAdmin(orgId) {
      let adminData = getUserData();
      return isSignedIn() && 
             adminData.role == 'admin' && 
             adminData.organizationId == orgId;
    }

    // Helper: Check if an organization is suspended
    function isNotSuspended(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.suspended != true;
    }

    // Organizations
    match /organizations/{orgId} {
      allow create: if isSignedIn();
      allow read: if true; // Publicly readable for checkpoint verification
      allow update, delete: if isSuperAdmin() || isOrgAdmin(orgId);
    }

    // User Profiles
    match /users/{userId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == userId || 
        isOrgAdmin(resource.data.organizationId)
      );
      allow update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
      allow delete: if isSuperAdmin() || (isSignedIn() && isOrgAdmin(getUserData().organizationId));
    }

    // Attendance Logs
    match /attendance_logs/{logId} {
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        (request.query.limit <= 500 && resource.data.userId == request.auth.uid) ||
        (getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId)
      );
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid || 
        (getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId)
      );
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid && 
                    isNotSuspended(request.resource.data.organizationId);
      allow update: if isSignedIn() && 
                    resource.data.userId == request.auth.uid && 
                    isNotSuspended(resource.data.organizationId);
      allow delete: if isSuperAdmin() || (isSignedIn() && isOrgAdmin(getUserData().organizationId));
    }

    // Visitor Logs
    match /visitor_logs/{logId} {
      allow create: if true; // Publicly createable via checkpoint
      allow read, list, delete: if isSignedIn() && (
        isSuperAdmin() || (getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId)
      );
    }
  }
}
