
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get the requesting user's profile data
    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Organizations
    match /organizations/{orgId} {
      allow create: if isSignedIn();
      allow read: if true; // Publicly readable for checkpoint verification
      allow update, delete: if isSignedIn() && (getProfile().role == 'super-admin' || (getProfile().role == 'admin' && getProfile().organizationId == orgId));
    }

    // User Profiles
    match /users/{userId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        getProfile().role == 'super-admin' || 
        (getProfile().role == 'admin' && resource.data.organizationId == getProfile().organizationId)
      );
      allow list: if isSignedIn() && (getProfile().role == 'admin' || getProfile().role == 'super-admin');
      allow update: if isSignedIn() && (request.auth.uid == userId || getProfile().role == 'super-admin');
      allow delete: if isSignedIn() && getProfile().role == 'super-admin';
    }

    // Attendance Logs
    match /attendance_logs/{logId} {
      // Explicitly allow listing based on organizationId or userId filters
      allow list, get: if isSignedIn() && (
        getProfile().role == 'super-admin' ||
        resource.data.userId == request.auth.uid ||
        resource.data.organizationId == getProfile().organizationId
      );
      
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
                    
      allow update: if isSignedIn() && (
        getProfile().role == 'super-admin' ||
        resource.data.userId == request.auth.uid || 
        getProfile().role == 'admin'
      );
      
      allow delete: if isSignedIn() && (getProfile().role == 'super-admin' || getProfile().role == 'admin');
    }

    // Visitor Logs
    match /visitor_logs/{logId} {
      allow create: if true; // Publicly createable via checkpoint
      allow read, list: if isSignedIn() && (
        getProfile().role == 'super-admin' || 
        (getProfile().role == 'admin' && resource.data.organizationId == getProfile().organizationId)
      );
      allow delete: if isSignedIn() && getProfile().role == 'super-admin';
    }
  }
}
