
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get the requesting user's profile data
    // Optimized to ensure it can be resolved during list operations
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if the requesting user is a super admin
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super-admin';
    }

    // Organizations
    match /organizations/{orgId} {
      allow create: if isSignedIn();
      allow read: if true; // Publicly readable for checkpoint verification
      allow update, delete: if isSuperAdmin() || (isSignedIn() && getUserData().role == 'admin' && getUserData().organizationId == orgId);
    }

    // User Profiles
    match /users/{userId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == userId || 
        (getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId)
      );
      allow update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    // Attendance Logs
    match /attendance_logs/{logId} {
      // Explicitly allow listing for the user themselves or their organization's admin
      allow list, get: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId)
      );
      
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid;
                    
      allow update: if isSignedIn() && (
                    isSuperAdmin() ||
                    resource.data.userId == request.auth.uid || 
                    (getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId)
      );
      
      allow delete: if isSuperAdmin() || (isSignedIn() && getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId);
    }

    // Visitor Logs
    match /visitor_logs/{logId} {
      allow create: if true; // Publicly createable via checkpoint
      allow read, list: if isSignedIn() && (
        isSuperAdmin() || (getUserData().role == 'admin' && resource.data.organizationId == getUserData().organizationId)
      );
      allow delete: if isSuperAdmin();
    }
  }
}
